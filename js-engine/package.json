{
  "name": "tagsearch-js",
  "version": "1.0.1",
  "description": "In-memory tag search engine for e-commerce (DAWG + BM25 + hybrid ranking), zero dependencies",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "license": "MIT",
  "author": "Gillesto66 <gillesto66@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gillesto66/e-cormmerce-site-search.git",
    "directory": "js-engine"
  },
  "homepage": "https://github.com/Gillesto66/e-cormmerce-site-search#readme",
  "bugs": { "url": "https://github.com/Gillesto66/e-cormmerce-site-search/issues" },
  "keywords": ["search", "e-commerce", "tags", "bm25", "dawg", "fuzzy", "autocomplete", "in-memory", "typescript"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
